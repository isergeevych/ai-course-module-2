# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Какой провайдер использовать по умолчанию: openrouter | openai | ollama
LLM_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys (основной облачный провайдер)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI напрямую — опционально; если пусто, в цепочке fallback он пропускается
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Локальная модель (Ollama, ключ не нужен)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# Кеш для 2.4 / 2.5: memory | redis
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
